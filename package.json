{
  "name": "canal360-react",
  "version": "1.0.0",
  "private": true,
  "description": "Canal 360 - painel estatico para Agente Autorizado.",
  "scripts": {
    "dev": "node scripts/serve-static.js demo 8085 --open",
    "start": "npm run dev",
    "preview": "node scripts/serve-static.js dist 8085 --open",
    "build": "node scripts/build_site.js",
    "data:install": "python -m pip install -r requirements_data.txt",
    "data:build": "python scripts/build_data.py",
    "data:update": "node scripts/update_data.js",
    "check": "npm run build"
  },
  "engines": {
    "node": ">=20"
  }
}
